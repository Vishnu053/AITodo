# Optional. Without a key the app works fully offline; AI features are simply hidden.
ANTHROPIC_API_KEY=
# Model used for refining todos and the daily brief (fast + cheap is the point).
AI_MODEL=claude-haiku-5-5
# Optional shared secret. If set, clients must send it (entered once in the app menu).
# Strongly recommended whenever the server is reachable from the internet.
ACCESS_TOKEN=
PORT=3000
# Set to 1 only when running behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=
